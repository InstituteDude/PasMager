# ==============================================================
#  PasMager — Template Environment Variables (Backend)
#
#  Salin file ini menjadi .env lalu isi dengan nilai kamu sendiri:
#      cp .env.example .env
#
#  JANGAN pernah commit file .env yang sudah terisi.
#  File ini (.env.example) hanya berisi placeholder — aman di-commit.
# ==============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# Domain frontend yang diizinkan mengakses API (pisahkan dengan koma).
# Contoh production: https://pasmager.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=isi_username_database_kamu
DB_PASSWORD=isi_password_database_kamu
DB_NAME=pasmager

# --- Keamanan ---
# JWT_SECRET: string acak minimal 32 karakter. WAJIB diisi.
# Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ENCRYPTION_MASTER_SALT: "pepper" server untuk menurunkan kunci enkripsi vault.
# WAJIB diisi & JANGAN PERNAH DIUBAH setelah ada data tersimpan —
# mengubah nilai ini membuat seluruh vault yang sudah ada tidak bisa didekripsi.
# Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_SALT=

# --- AI Financial Advisor (opsional) ---
# Kosongkan kalau tidak dipakai — aplikasi otomatis memakai rule engine lokal.
# Catatan privasi: bila diisi, ringkasan data aset dikirim ke penyedia AI terkait.
GEMINI_API_KEY=
OPENAI_API_KEY=
